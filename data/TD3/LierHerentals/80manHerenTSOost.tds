Aspect: green
	IconE: groenTSE.xpm zwartTSE.xpm
	IconW: groenTSW.xpm zwartTSW.xpm
	IconN: groenTSN.xpm zwartTSN.xpm
	IconS: groenTSS.xpm zwartTSS.xpm
	Action: speedLimit 80

Aspect: yellow60
	IconE: geelTSE.xpm zwartTSE.xpm
	IconW: geelTSW.xpm zwartTSW.xpm
	IconN: geelTSN.xpm zwartTSN.xpm
	IconS: geelTSS.xpm zwartTSS.xpm
	Action: speedLimit 40

Aspect: ggh60
	IconE: gghTSE.xpm zwartTSE.xpm
	IconW: gghTSW.xpm zwartTSW.xpm
	IconN: gghTSN.xpm zwartTSN.xpm
	IconS: gghTSS.xpm zwartTSS.xpm
	Action: speedLimit 60

Aspect: green60
	IconE: groenTSE.xpm zwartTSE.xpm
	IconW: groenTSW.xpm zwartTSW.xpm
	IconN: groenTSN.xpm zwartTSN.xpm
	IconS: groenTSS.xpm zwartTSS.xpm
	Action: speedLimit 60

# initial aspect

OnInit:
	.aspect = red
	.fleeted = 0
end

OnCleared:
       	if next.aspect = red
		.aspect = yellow
      	else	
		.aspect = green
   	end
end


OnUpdate:
	if .aspect = red 
		return 
	end
	if next.aspect = red
		if .switchThrown 
			.aspect = yellow60
		else
			.aspect = yellow
	else 
		if .switchThrown
			if next.aspect = yellow40 or next.aspect = ggh40 or next.aspect = green40
				.aspect = ggh60
			else
				.aspect = green60
			end
		else
			if next.aspect = yellow40 or next.aspect = ggh40 or next.aspect = green40
				.aspect = ggh
			else
				.aspect = green
			end
	end
end

