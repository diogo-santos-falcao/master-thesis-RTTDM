Aspect: red
	IconE: roodE.xpm
	IconW: roodW.xpm
	IconN: roodN.xpm
	IconS: roodS.xpm
	Action: stop

Aspect: yellow
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: ggv
	IconE: ggvE.xpm
	IconW: ggvW.xpm
	IconN: ggvN.xpm
	IconS: ggvS.xpm
	Action: speedLimit 60

Aspect: green
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 60

# initial aspect

OnInit:
	.aspect = red
	.fleeted = 0
end

OnCleared:
       	if next.aspect = red
		.aspect = yellow
      	else	
		.aspect = green
   	end
end


OnUpdate:
	if .aspect = red 
		return 
	end
	if next.aspect = red
		.aspect = yellow
	else 
		if next.aspect = yellow
			.aspect = ggv
		else
			.aspect = green
		end
	end
end

