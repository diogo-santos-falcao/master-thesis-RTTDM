Aspect: red
	IconE: roodE.xpm
	IconW: roodW.xpm
	IconN: roodN.xpm
	IconS: roodS.xpm
	Action: stop

Aspect: yellow
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: ggh
	IconE: gghE.xpm
	IconW: gghW.xpm
	IconN: gghN.xpm
	IconS: gghS.xpm
	Action: speedLimit 120

Aspect: green
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 120

Aspect: yellow60
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: ggh60
	IconE: gghE.xpm
	IconW: gghW.xpm
	IconN: gghN.xpm
	IconS: gghS.xpm
	Action: speedLimit 60

Aspect: green60
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 60

# initial aspect

OnInit:
	.aspect = red
	.fleeted = 0
end

OnCleared:
       	if next.aspect = red
		.aspect = yellow
      	else	
		.aspect = green
   	end
end



OnUpdate:
	if .aspect = red
		return 
	end 
	if .switchThrown
		if next.aspect = red
			.aspect = yellow60
		else 
			if next.aspect = green60 or next.aspect = yellow60
				.aspect = ggh60
			else
				.aspect = green60
			end
		end
	else
		if next.aspect = red
			.aspect = yellow
		else 
			if next.aspect = green60 or next.aspect = yellow60
				.aspect = ggh
			else
				.aspect = green
			end
		end
end

