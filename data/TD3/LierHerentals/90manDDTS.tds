Aspect: green60
	IconE: groenTSE.xpm zwartTSE.xpm
	IconW: groenTSW.xpm zwartTSW.xpm
	IconN: groenTSN.xpm zwartTSN.xpm
	IconS: groenTSS.xpm zwartTSS.xpm
	Action: speedLimit 60

# initial aspect

OnInit:
	.aspect = red
	.fleeted = 0
end

OnCleared:
       	if next.aspect = red
		.aspect = yellow
      	else	
		.aspect = green
   	end
end


OnUpdate:
	if .aspect = red 
		return 
	end
	if .switchThrown
		if .nextLimit = 90
			if next.aspect = yellow40 or next.aspect = ggh40 or next.aspect = green40
				.aspect = ggh60
			else
				if next.aspect = red
					.aspect = yellow60
				else
					if next.aspect = yellow
						.aspect = ggv60
					else
						.aspect = green60
					end
				end
		else
			.aspect = yellow40
		end
	else
		if next.aspect = red
			.aspect = yellow
		else
			if next.aspect = yellow
				.aspect = ggv
			else
				.aspect = green
			end
		end
	end
end

