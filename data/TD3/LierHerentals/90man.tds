Aspect: red
	IconE: roodE.xpm
	IconW: roodW.xpm
	IconN: roodN.xpm
	IconS: roodS.xpm
	Action: stop

Aspect: yellow
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: green
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 90

# initial aspect

OnInit:
	.aspect = red
	.fleeted = 0
end

OnCleared:
       	if next.aspect = red
		.aspect = yellow
      	else	
		.aspect = green
   	end
end


OnUpdate:
	if .aspect = red 
		return 
	end
	if next.aspect = red
		.aspect = yellow
	else 
		.aspect = green
	end
end

