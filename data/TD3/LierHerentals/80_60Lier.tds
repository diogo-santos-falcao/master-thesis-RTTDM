Aspect: red
	IconE: roodE.xpm
	IconW: roodW.xpm
	IconN: roodN.xpm
	IconS: roodS.xpm
	Action: stop

Aspect: yellow
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: green
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 80

Aspect: yellow60
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: green60
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 60

# initial aspect

OnInit:
	.aspect = red
	.fleeted = 0
end

OnCleared:
       	if next.aspect = red
		.aspect = yellow
      	else	
		.aspect = green
   	end
end



OnUpdate:
	if .aspect = red
		return 
	end 
	if next.aspect = red 
		if .switchThrown
			.aspect = yellow60
		else 
			.aspect = yellow 
	else 
		if .switchThrown
			.aspect = green60
		else  
			.aspect = green
		end
	end
end

