Aspect: yellow40
	IconE: geelTSE.xpm zwartTSE.xpm
	IconW: geelTSW.xpm zwartTSW.xpm
	IconN: geelTSN.xpm zwartTSN.xpm
	IconS: geelTSS.xpm zwartTSS.xpm
	Action: speedLimit 40

# initial aspect

OnInit:
	.aspect = red
	.fleeted = 0
end

OnCleared:
       	if next.aspect = red
		.aspect = yellow
      	else	
		.aspect = green
   	end
end



OnUpdate:
	if .aspect = red
		return 
	end 
	if .nextLength < 750
		.aspect = yellow40
	else
		if .switchThrown
			if next.aspect = red
				.aspect = yellow60
			else
				if next.aspect = green40 or next.aspect = yellow40
					.aspect = ggh60
				else 
					if next.aspect = yellow
						.aspect = ggv60
					else
						.aspect = green60
					end
				end
			end
		else
			if next.aspect = red
				.aspect = yellow
			else
				if next.aspect = green40 or next.aspect = yellow40
					.aspect = ggh
				else 
					if next.aspect = yellow
						.aspect = ggv
					else
						.aspect = green
					end
				end
			end
		end
	end
end

