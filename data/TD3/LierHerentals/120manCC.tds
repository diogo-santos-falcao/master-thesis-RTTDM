Aspect: red
	IconE: roodE.xpm
	IconW: roodW.xpm
	IconN: roodN.xpm
	IconS: roodS.xpm
	Action: stop

Aspect: pk
	IconE: roodWitE.xpm
	IconW: roodWitW.xpm
	IconN: roodWitN.xpm
	IconS: roodWitS.xpm
	Action: speedLimit 40

Aspect: yellow40
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: ggh40
	IconE: gghE.xpm
	IconW: gghW.xpm
	IconN: gghN.xpm
	IconS: ggh.xpm
	Action: speedLimit 40

Aspect: green40
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 40

Aspect: yellow
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: ggh
	IconE: gghE.xpm
	IconW: gghW.xpm
	IconN: gghN.xpm
	IconS: ggh.xpm
	Action: speedLimit 120

Aspect: green
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 120

# initial aspect

OnInit:
	.aspect = red
	.fleeted = 0
end

OnCleared:
       	if next.aspect = red
		.aspect = yellow
      	else	
		.aspect = green
   	end
end


OnUpdate:
	if .aspect = red 
		return 
	end
	if next.aspect = red
		.aspect = yellow
	else 
		if .nextLength < 1000
			.aspect = pk 
		else
			if .switchThrown
				if next.aspect = green or next.aspect = yellow or next.aspect = ggv 
					.aspect = green40
				else
					if next.aspect = green60 or next.aspect = yellow60 or next.aspect = yellow40 or next.aspect = ggh60 or next.aspect = ggv60
						.aspect = ggh40
					else
						.aspect = yellow40 
					end
				end
			else
				if next.aspect = red
					.aspect = yellow
				else
					if next.aspect = ggv or next.aspect = ggh or next.aspect = yellow or next.aspect = green
						.aspect = green
					else
						.aspect = ggh
					end
				end
			end
		end
	end
end

