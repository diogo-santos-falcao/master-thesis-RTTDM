Aspect: red
	IconE: roodE.xpm
	IconW: roodW.xpm
	IconN: roodN.xpm
	IconS: roodS.xpm
	Action: stop

Aspect: yellow
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: yellow40
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: yellow60
	IconE: geelE.xpm
	IconW: geelW.xpm
	IconN: geelN.xpm
	IconS: geelS.xpm
	Action: speedLimit 40

Aspect: ggv
	IconE: ggvE.xpm
	IconW: ggvW.xpm
	IconN: ggvN.xpm
	IconS: ggvS.xpm
	Action: speedLimit 90

Aspect: ggv60
	IconE: ggvE.xpm
	IconW: ggvW.xpm
	IconN: ggvN.xpm
	IconS: ggvS.xpm
	Action: speedLimit 60

Aspect: ggh
	IconE: gghE.xpm
	IconW: gghW.xpm
	IconN: gghN.xpm
	IconS: gghS.xpm
	Action: speedLimit 90

Aspect: green
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 90

Aspect: green60
	IconE: groenE.xpm
	IconW: groenW.xpm
	IconN: groenN.xpm
	IconS: groenS.xpm
	Action: speedLimit 60

# initial aspect

OnInit:
	.aspect = red
	.fleeted = 0
end

OnCleared:
       	if next.aspect = red
		.aspect = yellow
      	else	
		.aspect = green
   	end
end


OnUpdate:
	if .aspect = red 
		return 
	end
	if .switchThrown 
		if .nextLimit = 90
			if next.aspect = red
				.aspect = yellow60
			else
				if next.aspect = yellow
					.aspect = ggv60
				else
					.aspect = green60
				end
			end
		else
			.aspect = yellow40
		end
	else
		if next.aspect = red
			.aspect = yellow
		else
			if next.aspect = yellow
				.aspect = ggv
			else
				if next.aspect = yellow40 or next.aspect = green40 or next.aspect = ggh40
					.aspect = ggh
				else
					.aspect = green
				end
			end
		end
	end
end

